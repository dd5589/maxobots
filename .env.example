# ---------- Runtime ----------
NODE_ENV=development
BOT_TRANSPORT=polling
PORT=10000
TZ=Europe/Moscow

# ---------- MAX ----------
BOT_TOKEN=
MAX_WEBHOOK_DOMAIN=
MAX_WEBHOOK_PATH=/webhook
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PORT=10000
MAX_WEBHOOK_UPDATE_TYPES=bot_started,message_created,message_callback
MAX_WEBHOOK_START_RETRIES=12
MAX_WEBHOOK_RETRY_DELAY_MS=5000

# ---------- Local persistent storage ----------
DATA_DIR=./runtime
SESSION_TTL_SECONDS=7200
MAX_ANSWER_LENGTH=2000
